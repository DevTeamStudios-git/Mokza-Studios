# Mokza Studios — Environment Variables
# Copy this file to .env and fill in your values

# Supabase (get from https://supabase.com/dashboard/project/pgxgfhqwzkdayhbyqfvl/settings/api)
SUPABASE_URL=https://pgxgfhqwzkdayhbyqfvl.supabase.co
SUPABASE_PROJECT_REF=pgxgfhqwzkdayhbyqfvl
SUPABASE_ANON_KEY=your_anon_key_here
# ⚠️ SERVICE ROLE KEY — SERVER SIDE ONLY, NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Server
PORT=3001

# Optional: Firebase (legacy, kept for workspace/)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# ── Auth (REQUIRED in production) ───────────────────────────────────────────────
# Signing key for session tokens, 32+ random chars:  node scripts/hash-password.js --secret
AUTH_SECRET=
# Staff password logins, JSON. Hashes via:  node scripts/hash-password.js
# {"Name":{"hash":"scrypt$<salt>$<hex>","rank":"Owner"}}   ranks: Owner, CoOwner, Developer, Apprentice
STAFF_ACCOUNTS=
# Optional extra gate on the staff login form (same hash format)
STAFF_SECURITY_CODE_HASH=
# Emails (verified by Google/Discord) that become Owner on sign-in
BOOTSTRAP_OWNER_EMAILS=
# Only needed if the API is called from another origin (comma-separated)
CORS_ORIGINS=
